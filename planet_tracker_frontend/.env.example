# Planet Tracker Frontend - Environment configuration
# Copy this file to ".env" and adjust values for your preview/deployment.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Full base URL to the Flask backend (must include scheme and port).
# IMPORTANT: If your frontend is served over HTTPS, this URL MUST be HTTPS too,
# otherwise the browser will block mixed content.
#
# Replace <your-preview-host> with your actual preview hostname.
# Example using the running containers info:
#   Backend Docs: https://vscode-internal-32328-qa.qa01.cloud.kavia.ai:3001/docs
# so set:
REACT_APP_API_BASE_URL=https://vscode-internal-32328-qa.qa01.cloud.kavia.ai:3001

# Optional: If you do NOT set REACT_APP_API_BASE_URL, the app will derive
# "scheme://<current-host>:3001" from window.location with an optional override below.
# Prefer setting REACT_APP_API_BASE_URL above for reliability.
# REACT_APP_API_SCHEME=https

# Optional NASA APOD key (for richer images). If unset, generic NASA images are used.
# REACT_APP_NASA_API_KEY=
