# Frontend Environment Example

# Preferred: set the full backend base URL (scheme + host + port)
# For preview both services usually share the same host; backend runs on 3001.
# Example with HTTPS:
# REACT_APP_API_BASE_URL=https://<your-preview-host>:3001
REACT_APP_API_BASE_URL=

# Optional: scheme override if you cannot provide full REACT_APP_API_BASE_URL.
# Values: http | https
# Note: Browsers block mixed content (HTTPS page -> HTTP API). Prefer setting REACT_APP_API_BASE_URL.
REACT_APP_API_SCHEME=

# Optional NASA API key for richer APOD fallbacks
REACT_APP_NASA_API_KEY=
