# Planet Tracker Frontend - Environment Example
# Copy this file to ".env" and adjust as needed. Do NOT commit your .env.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Absolute base URL of the backend API. If not provided, the app will default to
# the same hostname as the current page on port 3001 (preview convention).
# Examples:
# REACT_APP_API_BASE_URL=https://localhost:3001
# REACT_APP_API_BASE_URL=https://vscode-internal-32328-qa.qa01.cloud.kavia.ai:3001
REACT_APP_API_BASE_URL=

# Optional NASA API key used for APOD fallback in image services.
# If omitted, the app will use generic public domain images as placeholders.
REACT_APP_NASA_API_KEY=
