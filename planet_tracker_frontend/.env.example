# Planet Tracker Frontend configuration

# Optional: Explicitly set backend API base URL. If not set, the app will
# derive it by swapping :3000 -> :3001 in the current origin, or use same-origin.
REACT_APP_API_BASE_URL=https://localhost:3001

# Optional: NASA API key to enable APOD fallbacks for richer imagery.
REACT_APP_NASA_API_KEY=YOUR_NASA_KEY_HERE
