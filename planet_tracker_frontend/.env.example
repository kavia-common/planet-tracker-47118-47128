# Frontend environment configuration for Planet Tracker

# Recommended: set the full backend base URL (scheme + host + port).
# For preview, backend runs on 3001 over HTTPS:
# Replace <your-preview-host> with your actual preview hostname (no trailing slash).
REACT_APP_API_BASE_URL=https://<your-preview-host>:3001

# Optional: If you cannot set REACT_APP_API_BASE_URL, you may force scheme selection.
# REACT_APP_API_SCHEME=https

# Optional NASA key (improves fallback images)
# REACT_APP_NASA_API_KEY=your_nasa_api_key_here
