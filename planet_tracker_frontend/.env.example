# Frontend environment example for Planet Tracker

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Full base URL for the backend API. Strongly recommended to avoid mixed-content
# and host mismatch issues in previews. Must include scheme and port 3001.
# Example for this workspace preview:
#   https://vscode-internal-32328-qa.qa01.cloud.kavia.ai:3001
REACT_APP_API_BASE_URL=

# Optional: Force scheme used when deriving API base from window.location
# Only used if REACT_APP_API_BASE_URL is not provided.
# REACT_APP_API_SCHEME=https
